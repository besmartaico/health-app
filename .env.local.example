# Copy this file to .env.local and fill in the values from
# Vercel -> health-app -> Settings -> Environment Variables.
# .env.local is gitignored and must never be committed.

# --- Google service account (Sheets + Drive) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# Keep the literal \n characters exactly as they appear in Vercel; wrap in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Master spreadsheet id (from the sheet URL)
GOOGLE_SHEETS_CRM_ID=your-sheet-id

# Google Drive folder id used by the COA upload route (optional)
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Email ---
RESEND_API_KEY=re_...

# --- Auth ---
ADMIN_PIN=your-admin-pin
SSO_SECRET=your-sso-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
